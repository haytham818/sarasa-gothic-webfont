{
  "name": "sarasa-gothic-webfont",
  "version": "0.1.0",
  "description": "Unicode-range webfont package for Sarasa UI SC.",
  "license": "MIT AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haytham818/sarasa-gothic-webfont.git"
  },
  "homepage": "https://github.com/haytham818/sarasa-gothic-webfont#readme",
  "bugs": {
    "url": "https://github.com/haytham818/sarasa-gothic-webfont/issues"
  },
  "type": "module",
  "style": "./index.css",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.css": "./index.css",
    "./extralight.css": "./fonts/extralight/index.css",
    "./light.css": "./fonts/light/index.css",
    "./regular.css": "./fonts/regular/index.css",
    "./semibold.css": "./fonts/semibold/index.css",
    "./bold.css": "./fonts/bold/index.css"
  },
  "files": [
    "index.css",
    "index.d.ts",
    "index.js",
    "fonts/",
    "LICENSE",
    "LICENSE-MIT.txt",
    "LICENSE-OFL.txt",
    "README.md",
    "font-source.json"
  ],
  "sideEffects": [
    "*.css",
    "fonts/**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "pnpm run verify",
    "prepack": "pnpm run verify"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "cn-font-split": "7.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0"
}
