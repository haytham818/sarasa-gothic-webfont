{
  "name": "sarasa-gothic-webfont",
  "version": "0.3.1",
  "description": "Build-time integrations for Unicode-range Sarasa Gothic webfonts.",
  "license": "MIT AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haytham818/sarasa-gothic-webfont.git"
  },
  "homepage": "https://github.com/haytham818/sarasa-gothic-webfont#readme",
  "bugs": {
    "url": "https://github.com/haytham818/sarasa-gothic-webfont/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./config": {
      "types": "./config.d.ts",
      "import": "./config.js",
      "default": "./config.js"
    },
    "./next": {
      "types": "./next.d.ts",
      "import": "./next.js",
      "default": "./next.js"
    },
    "./next/config": {
      "types": "./next-config.d.ts",
      "import": "./next-config.js",
      "default": "./next-config.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sarasa-gothic-webfont": "./cli.js"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "config.d.ts",
    "config.js",
    "next.d.ts",
    "next.js",
    "next-config.d.ts",
    "next-config.js",
    "cli.js",
    "lib/",
    "font-assets.json",
    "LICENSE",
    "LICENSE-MIT.txt",
    "LICENSE-OFL.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:assets": "node scripts/package-assets.mjs",
    "typecheck": "tsc",
    "verify": "node scripts/verify.mjs",
    "test": "pnpm run build:assets && pnpm run verify && pnpm run typecheck && node --test test/*.test.mjs && node scripts/test-next.mjs",
    "prepack": "pnpm test"
  },
  "dependencies": {
    "tar-stream": "3.2.1"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "cn-font-split": "7.4.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0"
}
