{
  "name": "sarasa-gothic-webfont",
  "version": "0.2.0",
  "description": "Build-time downloader for Unicode-range Sarasa Gothic webfonts.",
  "license": "MIT AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haytham818/sarasa-gothic-webfont.git"
  },
  "homepage": "https://github.com/haytham818/sarasa-gothic-webfont#readme",
  "bugs": {
    "url": "https://github.com/haytham818/sarasa-gothic-webfont/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./config": {
      "types": "./config.d.ts",
      "import": "./config.js",
      "default": "./config.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sarasa-gothic-webfont": "./cli.js"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "config.d.ts",
    "config.js",
    "cli.js",
    "lib/",
    "font-assets.json",
    "LICENSE",
    "LICENSE-MIT.txt",
    "LICENSE-OFL.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:assets": "node scripts/package-assets.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "pnpm run build:assets && pnpm run verify && node --test",
    "prepack": "pnpm test"
  },
  "dependencies": {
    "tar-stream": "3.2.1"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "cn-font-split": "7.4.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0"
}
